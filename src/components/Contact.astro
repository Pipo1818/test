---
// Kontaktsektion mit Formular + Ansprechpartner (dunkelgrün)
---
<section class="contact" id="kontakt">
  <div class="container contact-grid">
    <div class="contact-form">
      <h2>Kontakt</h2>
      <form method="post" action="/api/kontakt" data-contact-form>
        <div class="field"><label>Name <span class="req">*</span></label><input type="text" name="name" required /></div>
        <div class="field"><label>Telefonnummer <span class="req">*</span></label><input type="tel" name="tel" required /></div>
        <div class="field"><label>E-Mail-Adresse <span class="req">*</span></label><input type="email" name="email" required /></div>
        <div class="field"><label>Ihre Nachricht <span class="req">*</span></label><textarea name="message" required></textarea></div>
        <label class="check"><input type="checkbox" name="privacy" required /> <span>Ja, ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen <span class="req">*</span></span></label>
        <button type="submit" class="btn btn--primary btn--block btn--lg">Nachricht senden</button>
        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      </form>
    </div>
    <div class="contact-person">
      <div class="person-photo">
        <svg viewBox="0 0 320 320" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-label="Tim Bodung">
          <rect width="320" height="320" fill="#7baea7"/>
          <circle cx="160" cy="130" r="64" fill="#f0e2d6"/>
          <rect x="120" y="60" width="80" height="44" rx="22" fill="#34433d"/>
          <path d="M70 320c0-58 40-100 90-100s90 42 90 100z" fill="#fff"/>
          <circle cx="142" cy="124" r="7" fill="#34433d"/><circle cx="178" cy="124" r="7" fill="#34433d"/>
        </svg>
      </div>
      <p class="role">Ansprechpartner</p>
      <h3>Tim Bodung</h3>
      <div class="cline"><span class="cico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span><a href="tel:033628810099">03362 8810099</a></div>
      <div class="cline"><span class="cico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span><a href="mailto:info@pflege-planet.de">info@pflege-planet.de</a></div>
    </div>
  </div>
</section>
