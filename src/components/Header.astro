---
const links = [
  { href: '/pflegebox/', label: 'Pflegebox' },
  { href: '/pflegehilfsmittel-katalog/', label: 'Box bestellen' },
  { href: '/pflegebox/pflegebox-anpassen/', label: 'Box anpassen' },
  { href: '/ueber-uns/', label: 'Über uns' },
  { href: '/fragen/', label: 'Fragen & Antworten' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href;
---
<div class="topbar">
  <div class="container topbar-inner">
    <span class="topbar-text">Kostenlose Beratung</span>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7baea7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    <a href="tel:08009886053" class="topbar-phone">0800 988 60 53</a>
  </div>
</div>

<header class="site-header">
  <div class="container nav">
    <a href="/" class="brand"><img src="/assets/img/logo.svg" alt="" />Pflegeplanet</a>
    <div class="nav-icons">
      <a class="nav-ico" href="/pflegehilfsmittel-katalog/" aria-label="Produkte"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1-5h16l1 5"/><path d="M4 9v11h16V9"/><path d="M3 9h18"/><path d="M9 13h6"/></svg></a>
      <a class="nav-ico" href="tel:08009886053" aria-label="Anrufen"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></a>
      <button class="nav-toggle" aria-label="Menü" aria-expanded="false"><span></span><span></span><span></span></button>
    </div>
    <nav class="nav-links" aria-label="Hauptnavigation">
      {links.map((l) => (
        <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
